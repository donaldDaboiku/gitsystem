# Backend hardening

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !\.test$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Old /backend/admin address → /admin (THE_REQUEST avoids a rewrite loop)
    RewriteCond %{THE_REQUEST} \s/+backend/admin/login\.php[\s?] [NC]
    RewriteRule ^admin/login\.php$ /admin/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+backend/admin/?[\s?] [NC]
    RewriteRule ^admin/?$ /admin/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+backend/admin/.+[\s?] [NC]
    RewriteRule ^admin/(.+)$ /admin/$1 [R=301,L]
</IfModule>

# Deny direct access to config and local secrets
<FilesMatch "^(config\.php|config\.local\.php|security\.php)$">
    Require all denied
</FilesMatch>
