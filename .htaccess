# GITSYSTEM root — security headers + HTTPS (skip .test / localhost for Laragon)

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set X-XSS-Protection "0"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS except local Laragon / localhost
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !\.test$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Homepage is https://gitsystemng.com/ — drop /frontend/index.php from the address bar
    RewriteCond %{THE_REQUEST} \s/+frontend/index\.(php|html)[\s?] [NC]
    RewriteRule ^frontend/index\.(php|html)$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+frontend/?[\s?] [NC]
    RewriteRule ^frontend/?$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Admin is https://gitsystemng.com/admin
    RewriteRule ^admin$ /admin/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+admin/login\.php[\s?] [NC]
    RewriteRule ^admin/login\.php$ /admin/ [R=301,L]
    RewriteRule ^admin/$ backend/admin/login.php [L]
    RewriteRule ^admin/(.+)$ backend/admin/$1 [L]
</IfModule>

# Block hidden / sensitive paths if ever exposed at root
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
