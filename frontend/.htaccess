# Frontend — clean URLs + legacy .html support + security headers

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS except local Laragon / localhost
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !\.test$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Legacy .html → .php (bookmarks / search index)
    RewriteRule ^index\.html$ index.php [L,R=301]
    RewriteRule ^gitsystem\.html$ index.php [L,R=301]
    RewriteRule ^product\.html$ product.php [L,QSA]

    # Clean product URLs: /frontend/product/slug-name
    RewriteRule ^product/([a-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]

    # Block PHP includes from direct web access
    RewriteRule ^includes/ - [F,L]

    # Directory index
    DirectoryIndex index.php index.html
</IfModule>
